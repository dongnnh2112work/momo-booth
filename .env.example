STAFF_KEY=change-me-before-event
# Comma-separated booth ids. Restart after changing. Labels default to the id
# unless that id is one of the built-in booths or data/booths.json supplies it.
# data/booths.json is an optional array of { "id", "label", "title", "blurb", "sample" }.
# BOOTH_IDS=5-10,3-5
# Absolute origin for check-in QR codes and the setup-page check-in/display URLs.
# Optional. Trailing slashes are stripped. When unset, the browser origin is used.
# PUBLIC_BASE_URL is preferred. NEXT_PUBLIC_BASE_URL is the same setting for the
# client bundle; if both are set, PUBLIC_BASE_URL wins. Set only one.
# PUBLIC_BASE_URL=https://example.com
# NEXT_PUBLIC_BASE_URL=https://example.com
# Supabase is optional. Placeholders only — do not put real keys in this file.
# When both URL and SUPABASE_SERVICE_ROLE_KEY are unset, MOMO_LOCAL=1 keeps
# check-in in memory. Check-in writes use the service role on the server.
# POST /api/staff/manual-checkin is local-only: staff key, JSON body boothId and code.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never prefix it with NEXT_PUBLIC_.
# Never import it from a client component.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# npm run codes:sync upserts public.codes (columns code and booth only) from
# data/roster.json, or from ROSTER_PATH when that is set. It uses
# NEXT_PUBLIC_SUPABASE_URL, or SUPABASE_URL when the public URL is unset, and
# SUPABASE_SERVICE_ROLE_KEY. It exits with an error if either is missing.
# Safe to run again (primary key is code, booth). It does not print the key,
# the URL query string, or roster names. Placeholders only.
# SUPABASE_URL=https://your-project.supabase.co
# ROSTER_PATH=data/roster.json
# In-memory per-IP caps per rolling minute. Restart after changing. Same 429
# message; no Redis. Check-in defaults to 300 so many guests can share one
# office NAT address (200 check-ins from one IP in a burst stay allowed).
# Duplicates are still rejected per code and booth. Staff caps stay lower.
# Blank, non-integer, or non-positive values fall back to 300, 20, and 10.
# RATE_LIMIT_CHECKIN_PER_MIN=300
# RATE_LIMIT_STAFF_READ_PER_MIN=20
# RATE_LIMIT_STAFF_WRITE_PER_MIN=10
